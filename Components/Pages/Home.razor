@page "/"
@layout MABamlai.Components.Layout.EmptyLayout

<PageTitle>MA Bamlai</PageTitle>

<div class="welcome-wrapper">
    <div class="welcome-container">
        <div class="logo-area">
            <h1><span class="burgundy">MA</span> bamlai</h1>
            <div class="divider"></div>
        </div>

        <div class="text-area">
            <p>
                A website for managing equipment for the electronics team
                in the <span class="highlight">Makers Assemble #5951</span> robotics team.
            </p>
        </div>

        <div class="action-area">
            <a href="login" class="enter-btn">LOGIN</a>
            <a href="register" class="signup-btn">SIGN UP</a>
        </div>
    </div>
</div>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
        background: radial-gradient(circle at center, #2e2f3e 0%, #1d1e27 100%);
        color: #e0e0e0;
        height: 100vh;
        width: 100vw;
        overflow: hidden;
    }

    .welcome-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        width: 100vw;
        position: absolute;
        top: 0;
        left: 0;
        z-index: 100;
    }

    .welcome-container {
        text-align: center;
        padding: 40px;
        max-width: 900px;
        width: 90%;
        display: flex;
        flex-direction: column;
        gap: 30px;
        align-items: center;
    }

    h1 {
        font-size: clamp(3.5rem, 10vw, 7rem);
        font-weight: 900;
        letter-spacing: -1px;
        color: #ffffff;
        line-height: 0.85;
    }

    .burgundy {
        color: #990000;
        text-shadow: 0 0 25px rgba(153, 0, 0, 0.6);
    }

    .divider {
        height: 3px;
        width: 100px;
        background: linear-gradient(90deg, transparent, #990000, transparent);
        margin: 30px auto;
    }

    p {
        font-size: clamp(1.1rem, 2vw, 1.4rem);
        color: #c0c0c0;
        max-width: 600px;
        margin: 0 auto;
        font-weight: 300;
        line-height: 1.6;
    }

    .highlight {
        color: #ff3333;
        font-weight: 600;
    }

    .action-area {
        margin-top: 20px;
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .enter-btn,
    .signup-btn,
    .electronics-btn,
    .about-btn {
        display: inline-block;
        min-width: 150px;
        padding: 14px 30px;
        border: 2px solid #990000;
        color: #ffffff;
        text-decoration: none;
        font-weight: 700;
        letter-spacing: 2px;
        border-radius: 4px;
        transition: all 0.3s ease;
    }

    .enter-btn {
        background-color: transparent;
    }

    .signup-btn {
        background-color: #990000;
    }

    .electronics-btn {
        background-color: transparent;
    }

    .about-btn {
        background-color: rgba(153, 0, 0, 0.18);
    }

    .enter-btn:hover,
    .signup-btn:hover,
    .electronics-btn:hover,
    .about-btn:hover {
        box-shadow: 0 0 20px rgba(153, 0, 0, 0.5);
        transform: translateY(-2px);
    }

    .enter-btn:hover {
        background-color: #990000;
    }

    .signup-btn:hover {
        filter: brightness(1.06);
    }

    .electronics-btn:hover {
        background-color: rgba(153, 0, 0, 0.25);
    }

    .about-btn:hover {
        background-color: rgba(153, 0, 0, 0.35);
    }
</style>
